# Task: Keep asking the user to input a number until they type 0.
# Print each number entered, except don't print after they type 0 - just stop.
# Topics: while loop, sentinel value, input() type conversion, if inside a loop

number = " "  # placeholder value just so the loop condition is True on the first check
while number != 0:
    number = int(input("Give us a number: "))
    if number != 0:
        print(number)
