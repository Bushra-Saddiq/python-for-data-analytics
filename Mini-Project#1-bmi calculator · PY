# Mini Project: BMI Calculator
# Takes weight (kg) and height (m), calculates BMI, and categorizes the result
# Topics: type conversion, arithmetic (exponent), if/elif/else, round(), f-strings

weight = float(input("What's your body weight? "))
height = float(input("What's your height in meter? "))

BMI = weight / (height ** 2)

if BMI < 18.5:
    print("Underweight")
elif BMI <= 24.9:
    print("Normal weight")
elif BMI <= 29.9:
    print("Overweight")
else:
    print("Obese")

print(f"Your BMI value is: {round(BMI, 1)}")
